+RTDECL(int) RTStrCopy(char *pszDst, size_t cbDst, const char *pszSrc)
+{
+    size_t cchSrc = strlen(pszSrc);
+    if (cbDst > cchSrc)
+    {
+        memcpy(pszDst, pszSrc, cchSrc + 1);
+        return VINF_SUCCESS;
+    }
