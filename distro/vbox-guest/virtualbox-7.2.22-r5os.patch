+/**
+ * IDC entry used by the ring-0 client library (VBoxGuestR0LibIdc-unix.cpp).
+ * Same contract as the FreeBSD guest driver.
+ */
+int VBOXCALL VBoxGuestIDC(void *pvSession, uintptr_t uReq, PVBGLREQHDR pReqHdr, size_t cbReq)
+{
+    int rc;
+    if (   RT_VALID_PTR(pReqHdr)
+        && cbReq >= sizeof(*pReqHdr))
+    {
+        PVBOXGUESTSESSION pSession = (PVBOXGUESTSESSION)pvSession;
+        if (pSession)
+        {
+            if (   RT_VALID_PTR(pSession)
+                && pSession->pDevExt == &g_DevExt)
+                rc = VGDrvCommonIoCtl(uReq, &g_DevExt, pSession, pReqHdr, cbReq);
+            else
+                rc = VERR_INVALID_HANDLE;
+        }
+        else if (uReq == VBGL_IOCTL_IDC_CONNECT)
+        {
+            rc = VGDrvCommonCreateKernelSession(&g_DevExt, &pSession);
+            if (RT_SUCCESS(rc))
+            {
+                rc = VGDrvCommonIoCtl(uReq, &g_DevExt, pSession, pReqHdr, cbReq);
+                if (RT_FAILURE(rc))
+                    VGDrvCommonCloseSession(&g_DevExt, pSession);
+            }
+        }
+        else
+            rc = VERR_INVALID_HANDLE;
+    }
+    else
+        rc = VERR_INVALID_POINTER;
+    return rc;
+}
+
+void *VBoxGuestIDCOpen(uint32_t *pu32Version)
+{
+    PVBOXGUESTSESSION pSession = NULL;
+    int rc = VGDrvCommonCreateKernelSession(&g_DevExt, &pSession);
+    if (RT_FAILURE(rc))
+        return NULL;
+    if (pu32Version)
+        *pu32Version = VBGL_IOC_VERSION;
+    return pSession;
+}
+
+int VBoxGuestIDCClose(void *pvSession)
+{
+    VGDrvCommonCloseSession(&g_DevExt, (PVBOXGUESTSESSION)pvSession);
+    return VINF_SUCCESS;
+}
+
+int VBoxGuestIDCCall(void *pvSession, unsigned iCmd, void *pvData, size_t cbData, size_t *pcbDataReturned)
+{
+    RT_NOREF(pcbDataReturned);
+    return VGDrvCommonIoCtl(iCmd, &g_DevExt, (PVBOXGUESTSESSION)pvSession, (PVBGLREQHDR)pvData, cbData);
+}
 
