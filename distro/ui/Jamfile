SubDir HAIKU_TOP src preferences r5ui ;

# Primary arch: the target name is libr5ui.so. That is also the soname.
# Both images install it through HaikuImageGetSystemLibs.
SharedLibrary [ MultiArchDefaultGristFiles libr5ui.so ] :
	R5UI.cpp
	Card.cpp
	SidebarItem.cpp
	Sidebar.cpp
	ActionCard.cpp
	PageHeader.cpp
	ScreenArrangement.cpp
	: be libr5icons.so [ TargetLibstdc++ ]
	;
