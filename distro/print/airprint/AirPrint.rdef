resource app_signature "application/x-vnd.r5os-airprint";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "AirPrint",
	long_info = "IPP Everywhere / AirPrint PWG-raster driver for R5OS."
};
