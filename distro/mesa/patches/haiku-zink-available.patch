+// R5 GPU interface (r5_gpu.h, MIT): GET_INFO is the first call. Its first
+// 32 bytes are size, version, api_major, api_minor, vendor, device,
+// revision and capabilities. R5_GPU_CAP_AVAILABLE is set when the four
+// checks at boot passed and the GPU was not turned off since.
+#define R5_GPU_GET_INFO_OP 30479u
+#define R5_GPU_CAP_AVAILABLE_BIT 8u
+
+static bool
+r5_gl_gpu_available(const char *node)
+{
+   int fd = open(node, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return false;
+   uint32_t info[8];
+   memset(info, 0, sizeof(info));
+   info[0] = sizeof(info);
+   bool available = ioctl(fd, R5_GPU_GET_INFO_OP, info, sizeof(info)) == 0
+      && (info[7] & R5_GPU_CAP_AVAILABLE_BIT) != 0;
+   close(fd);
+   return available;
+}
