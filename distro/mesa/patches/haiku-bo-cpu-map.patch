Haiku cannot map a buffer with DRM_AMDGPU_GEM_MMAP and mmap() on the
render node. ac_drm_bo_cpu_map and RADV's winsys map call libdrm's
r5_bo_cpu_map. The shader-cache mmap of a file stays.

--- a/src/amd/common/ac_linux_drm.c
+++ b/src/amd/common/ac_linux_drm.c
@@ -962,6 +962,54 @@ int ac_drm_bo_free(ac_drm_device *dev, ac_drm_bo bo)
    return amdgpu_bo_free(bo.abo);
 }
 
+#if defined(__HAIKU__) || defined(R5_HOST_TEST)
+extern int r5_bo_cpu_map(int fd, unsigned int handle, void **cpu, int *area);
+extern int r5_bo_cpu_unmap(int fd, int area);
+
+struct r5_cpu_map {
+   uint32_t handle;
+   int area;
+};
+
+static struct r5_cpu_map r5_cpu_maps[32];
+
+static int
+r5_cpu_map_save(uint32_t handle, int area)
+{
+   unsigned i;
+   for (i = 0; i < 32; i++) {
+      if (r5_cpu_maps[i].handle == 0 || r5_cpu_maps[i].handle == handle) {
+         r5_cpu_maps[i].handle = handle;
+         r5_cpu_maps[i].area = area;
+         return 0;
+      }
+   }
+   return -1;
+}
+
+static int
+r5_cpu_map_take(uint32_t handle)
+{
+   unsigned i;
+   for (i = 0; i < 32; i++) {
+      if (r5_cpu_maps[i].handle == handle) {
+         int area = r5_cpu_maps[i].area;
+         r5_cpu_maps[i].handle = 0;
+         r5_cpu_maps[i].area = 0;
+         return area;
+      }
+   }
+   return -1;
+}
+#endif
