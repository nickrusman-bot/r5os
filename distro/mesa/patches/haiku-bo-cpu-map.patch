+   int ret = amdgpu_bo_export(bo.abo, amdgpu_bo_handle_type_kms, &handle);
+   if (ret)
+      return ret;
+   ret = r5_bo_cpu_map(dev->fd, handle, cpu, &area);
+   if (ret)
+      return ret;
+   if (r5_cpu_map_save(handle, area)) {
+      r5_bo_cpu_unmap(dev->fd, area);
+      return -1;
+   }
+   return 0;
+#else
    return amdgpu_bo_cpu_map(bo.abo, cpu);
+#endif
