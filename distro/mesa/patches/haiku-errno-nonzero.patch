ac_drm_query_info goes through os_drm.h drm_ioctl, which returns -errno.
On Haiku that value is positive, so a < 0 test misses the fault query.
The syncobj helpers return drmIoctl's -1 and are not in this patch.
libdrm's own return -errno stays, so Mesa's == -ETIME still matches.

--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
@@ -103,7 +103,8 @@ radv_amdgpu_winsys_query_gpuvm_fault(struct radeon_winsys *rws, struct radv_win
    int r;
 
    r = ac_drm_query_info(ws->dev, AMDGPU_INFO_GPUVM_FAULT, sizeof(gpuvm_fault), &gpuvm_fault);
-   if (r < 0) {
+   /* ac_drm_query_info returns -errno. On Haiku that value is positive. */
+   if (r != 0) {
       fprintf(stderr, "radv/amdgpu: Failed to query the last GPUVM fault (%d).\n", r);
       return false;
    }
