+// #pragma mark R5 driver choice
+
+static const char *const kR5Settings[] = {
+   "/boot/home/config/settings/kernel/drivers/radeon_hd",
+   "/boot/system/settings/kernel/drivers/radeon_hd",
+};
+
+struct r5_gl_settings {
+   bool gpuOff;
+   bool opengl;
+   bool forceFail;
+};
+
+// The first file that can be read, in the order libdrm-r5 uses. A file that
+// cannot be read means "not set".
+static void
+r5_gl_read_settings(struct r5_gl_settings *settings)
+{
+   memset(settings, 0, sizeof(*settings));
+   void *handle = NULL;
+   for (size_t i = 0; handle == NULL
+        && i < sizeof(kR5Settings) / sizeof(kR5Settings[0]); i++) {
+      handle = load_driver_settings(kR5Settings[i]);
+   }
+   if (handle == NULL)
+      return;
+   settings->gpuOff = !get_driver_boolean_parameter(handle, "gpu", true, true);
+   settings->opengl = get_driver_boolean_parameter(handle, "gpu_opengl",
+                                                   false, false);
+   settings->forceFail = get_driver_boolean_parameter(handle,
+      "gpu_opengl_fail", false, false);
+   unload_driver_settings(handle);
+}
+
+// Any entry under /dev/gpu/<driver>/. No driver name is assumed.
+static bool
+r5_gl_render_node(void)
+{
+   DIR *gpu = opendir("/dev/gpu");
+   if (gpu == NULL)
+      return false;
+   bool found = false;
+   struct dirent *driver;
+   while (!found && (driver = readdir(gpu)) != NULL) {
+      if (driver->d_name[0] == '.')
+         continue;
+      char path[B_PATH_NAME_LENGTH];
+      snprintf(path, sizeof(path), "/dev/gpu/%s", driver->d_name);
+      DIR *nodes = opendir(path);
+      if (nodes == NULL)
+         continue;
+      struct dirent *node;
+      while ((node = readdir(nodes)) != NULL) {
+         if (node->d_name[0] != '.') {
+            found = true;
+            break;
+         }
+      }
+      closedir(nodes);
+   }
+   closedir(gpu);
+   return found;
+}
+
+static bool
+r5_gl_is_zink(struct pipe_screen *screen)
+{
+   const char *name = screen->get_name(screen);
+   return name != NULL && strncmp(name, "zink", 4) == 0;
+}
+
+// R5_GL_TRACE=1 only: names the screen when no syslog line is due.
+static void
+r5_gl_trace_screen(struct pipe_screen *screen)
+{
+   if (screen != NULL)
+      r5_gl_log(false, "egl: opengl %s: %s",
+                r5_gl_is_zink(screen) ? "zink" : "llvmpipe",
+                screen->get_name(screen));
+}
+
+// M9 decision 3. The order of these checks is fixed. A line is written once
+// per process.
+static struct pipe_screen *
+r5_gl_create_screen(_EGLDisplay *disp, struct sw_winsys *winsys)
+{
+   static bool logged = false;
+   bool first = !logged;
+   logged = true;
+
+   // 1. The program asked for a driver itself: as before.
+   if (disp->Options.ForceSoftware || getenv("LIBGL_ALWAYS_SOFTWARE") != NULL
+       || getenv("GALLIUM_DRIVER") != NULL) {
+      struct pipe_screen *screen = sw_screen_create(winsys);
+      if (first)
+         r5_gl_trace_screen(screen);
+      return screen;
+   }
+
+   struct r5_gl_settings settings;
+   r5_gl_read_settings(&settings);
+   const char *reason = NULL;
+   struct pipe_screen *screen = NULL;
+   if (!settings.opengl)
+      reason = NULL; // 2. not asked for: no line
+   else if (settings.gpuOff)
+      reason = "gpu off";
+   else if (settings.forceFail)
+      reason = "forced failure";
+   else if (!r5_gl_render_node())
+      reason = "no render node";
+   else {
+      screen = sw_screen_create_zink(winsys, NULL, false);
+      if (screen == NULL)
+         reason = "zink failed";
+   }
+
+   if (screen != NULL) {
+      if (first)
+         r5_gl_log(true, "egl: opengl zink: %s", screen->get_name(screen));
+      return screen;
+   }
+
+   screen = sw_screen_create(winsys);
+   if (first) {
+      if (reason != NULL)
+         r5_gl_log(true, "egl: opengl llvmpipe: %s", reason);
+      else
+         r5_gl_trace_screen(screen);
+   }
+   return screen;
+}
