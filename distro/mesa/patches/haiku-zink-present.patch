+// #pragma mark R5 log
+
+static bool
+r5_gl_trace(void)
+{
+   static int trace = -1;
+   if (trace < 0) {
+      const char *value = getenv("R5_GL_TRACE");
+      trace = value != NULL && strcmp(value, "1") == 0;
+   }
+   return trace != 0;
+}
+
+// One line to the syslog (when asked), and to stderr with R5_GL_TRACE=1.
+static void
+r5_gl_log(bool toSyslog, const char *format, ...)
+{
+   char line[256];
+   va_list args;
+   va_start(args, format);
+   vsnprintf(line, sizeof(line), format, args);
+   va_end(args);
+   if (toSyslog)
+      syslog(LOG_INFO, "%s", line);
+   if (r5_gl_trace())
+      fprintf(stderr, "%s\n", line);
+}
+
+// #pragma mark R5 present
+
+// A Zink frame is read back into a BBitmap and handed to the window.
+// Up to two bitmaps that the window hands back are kept for later frames.
+#define R5_PRESENT_SPARES 2
+#define R5_PRESENT_SAMPLES 4096
+#define R5_PRESENT_REPORT 10000000
+
+struct r5_present {
+   BitmapHook *hook;
+   BBitmap *spare[R5_PRESENT_SPARES];
+   bool failed;
+   bigtime_t windowStart;
+   uint32_t frames;
+   uint32_t samples;
+   bigtime_t sample[R5_PRESENT_SAMPLES];
+};
+
+static bool
+r5_present_fail(struct r5_present *present, const char *why)
+{
+   if (!present->failed) {
+      present->failed = true;
+      if (why != NULL)
+         r5_gl_log(true, "egl: present failed: format %s", why);
+      else
+         r5_gl_log(true, "egl: present failed");
+   }
+   return false;
+}
+
+static bool
+r5_present_fits(BBitmap *bitmap, uint32_t width, uint32_t height,
+                color_space space)
+{
+   BRect bounds = bitmap->Bounds();
+   return bitmap->ColorSpace() == space
+      && (uint32_t)bounds.IntegerWidth() + 1 == width
+      && (uint32_t)bounds.IntegerHeight() + 1 == height;
+}
+
+// Reuses a spare of the right size and deletes a spare of the wrong size.
+static BBitmap *
+r5_present_bitmap(struct r5_present *present, uint32_t width, uint32_t height,
+                  color_space space)
+{
+   BBitmap *found = NULL;
+   for (int i = 0; i < R5_PRESENT_SPARES; i++) {
+      BBitmap *spare = present->spare[i];
+      if (spare == NULL)
+         continue;
+      if (!r5_present_fits(spare, width, height, space)) {
+         delete spare;
+         present->spare[i] = NULL;
+      } else if (found == NULL) {
+         found = spare;
+         present->spare[i] = NULL;
+      }
+   }
+   if (found != NULL)
+      return found;
+   BBitmap *bitmap = new (std::nothrow) BBitmap(
+      BRect(0, 0, width - 1, height - 1), 0, space);
+   if (bitmap != NULL && bitmap->InitCheck() != B_OK) {
+      delete bitmap;
+      bitmap = NULL;
+   }
+   return bitmap;
+}
+
+static void
+r5_present_keep(struct r5_present *present, BBitmap *bitmap)
+{
+   if (bitmap == NULL)
+      return;
+   for (int i = 0; i < R5_PRESENT_SPARES; i++) {
+      if (present->spare[i] == NULL) {
+         present->spare[i] = bitmap;
+         return;
+      }
+   }
+   delete bitmap;
+}
+
+static int
+r5_present_compare(const void *a, const void *b)
+{
+   bigtime_t x = *(const bigtime_t *)a;
+   bigtime_t y = *(const bigtime_t *)b;
+   return x < y ? -1 : x > y ? 1 : 0;
+}
+
+// With R5_GL_TRACE=1: the median time of one present, every 10 s.
+static void
+r5_present_measure(struct r5_present *present, bigtime_t start, bigtime_t end)
+{
+   if (!r5_gl_trace())
+      return;
+   if (present->windowStart == 0)
+      present->windowStart = start;
+   present->sample[present->frames % R5_PRESENT_SAMPLES] = end - start;
+   present->frames++;
+   if (present->samples < R5_PRESENT_SAMPLES)
+      present->samples++;
+   if (end - present->windowStart < R5_PRESENT_REPORT)
+      return;
+   qsort(present->sample, present->samples, sizeof(present->sample[0]),
+         r5_present_compare);
+   r5_gl_log(false, "egl: present median %lld us frames %u",
+             (long long)present->sample[present->samples / 2],
+             (unsigned)present->frames);
+   present->windowStart = end;
+   present->frames = 0;
+   present->samples = 0;
+}
+
+static bool
+r5_present_frame(struct hgl_buffer *buffer, struct pipe_context *pipe,
+                 struct pipe_resource *resource)
+{
+   struct r5_present *present = (struct r5_present *)buffer->present_data;
+   // A pbuffer has no window: nothing to show.
+   if (present == NULL || present->hook == NULL)
+      return true;
+   if (pipe == NULL || resource == NULL)
+      return r5_present_fail(present, NULL);
+
+   color_space space;
+   switch (resource->format) {
+   case PIPE_FORMAT_BGRX8888_UNORM:
+      space = B_RGB32;
+      break;
+   case PIPE_FORMAT_BGRA8888_UNORM:
+      space = B_RGBA32;
+      break;
+   default:
+      return r5_present_fail(present, util_format_name(resource->format));
+   }
+
+   bigtime_t start = system_time();
+   uint32_t width = resource->width0;
+   uint32_t height = resource->height0;
+   struct pipe_transfer *transfer = NULL;
+   const uint8_t *map = (const uint8_t *)pipe_texture_map(pipe, resource, 0,
+      0, PIPE_MAP_READ, 0, 0, width, height, &transfer);
+   if (map == NULL)
+      return r5_present_fail(present, NULL);
+
+   BBitmap *bitmap = r5_present_bitmap(present, width, height, space);
+   if (bitmap == NULL) {
+      pipe_texture_unmap(pipe, transfer);
+      return r5_present_fail(present, NULL);
+   }
+
+   // One copy when both rows are width * 4 bytes. The bitmap is not cleared.
+   size_t row = (size_t)width * 4;
+   size_t bitmapRow = (size_t)bitmap->BytesPerRow();
+   uint8_t *bits = (uint8_t *)bitmap->Bits();
+   if (bitmapRow == row && (size_t)transfer->stride == row) {
+      memcpy(bits, map, row * height);
+   } else {
+      for (uint32_t y = 0; y < height; y++)
+         memcpy(bits + y * bitmapRow, map + (size_t)y * transfer->stride, row);
+   }
+   pipe_texture_unmap(pipe, transfer);
+
+   r5_present_keep(present, present->hook->SetBitmap(bitmap));
+   r5_present_measure(present, start, system_time());
+   return true;
+}
+
+static bool
+r5_present_attach(struct hgl_buffer *buffer, BitmapHook *hook)
+{
+   struct r5_present *present =
+      (struct r5_present *)calloc(1, sizeof(struct r5_present));
+   if (present == NULL)
+      return false;
+   present->hook = hook;
+   buffer->present = r5_present_frame;
+   buffer->present_data = present;
+   return true;
+}
+
+// Takes the shown bitmap back, and deletes it and the spares.
+static void
+r5_present_detach(struct hgl_buffer *buffer)
+{
+   struct r5_present *present = (struct r5_present *)buffer->present_data;
+   if (present == NULL)
+      return;
+   if (present->hook != NULL)
+      delete present->hook->SetBitmap(NULL);
+   for (int i = 0; i < R5_PRESENT_SPARES; i++)
+      delete present->spare[i];
+   free(present);
+   buffer->present_data = NULL;
+   buffer->present = NULL;
+}
