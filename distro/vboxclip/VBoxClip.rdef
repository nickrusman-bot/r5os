resource app_signature "application/x-vnd.R5OS-vbox-clip";

resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;

resource app_name_catalog_entry "VBoxClip:application name" "VBox clipboard";

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "R5OS host clipboard",
	long_info = "Text clipboard over COM1 for VirtualBox. Not Guest Additions."
};
