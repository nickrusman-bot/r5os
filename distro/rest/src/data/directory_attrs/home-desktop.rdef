	"be:bgndimginfopath" = "/boot/system/data/artwork/r5-wallpaper.jpg",
	"be:bgndimginfomode" = 2,
	"be:bgndimginfoworkspaces" = -1,
	"be:bgndimginfooffset" = point { 0, 0 },
