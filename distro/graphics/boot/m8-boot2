#!/bin/sh
# Remove the settings file and write the CPU-copy boot. Restart only on y.
file=/boot/home/config/settings/kernel/drivers/radeon_hd
echo "m8-boot2: remove the settings file"
rm -f "$file"
if [ -f "$file" ]; then
	echo FAIL
	exit 1
fi
echo "m8-boot2: write boot 2"
mkdir -p "$(dirname "$file")"
{
	echo "gfx9_ring true"
	echo "gfx9_kernel true"
	echo "gfx9_irq true"
	echo "gfx9_gart true"
	echo "gpu_render true"
	echo "gpu_selftest true"
	echo "gfx9_wc_gtt false"
	echo "gfx9_vmids true"
	echo "gfx9_vmid_per_file true"
	echo "gfx9_pasid_map true"
	echo "gpu_present true"
	echo "gpu_copy_debug true"
} > "$file"
if [ ! -f "$file" ] || grep -q "^gpu_app_server true" "$file" \
	|| ! grep -q "^gpu_copy_debug true" "$file"; then
	echo FAIL
	exit 1
fi
echo "m8-boot2: settings"
cat "$file"
printf 'm8-boot2: restart? [y] '
read ans
if [ "$ans" = y ]; then
	echo PASS
	shutdown -r
else
	echo FAIL
	exit 1
fi
