# R5OS image profiles (copy to haiku/build/jam/UserBuildConfig).
# Do not commit this file into upstream Haiku; it is gitignored there.

# GitHub Haiku clones have no hrev tags. Keep in sync with distro/VERSION
# (scripts/apply-overlay.sh rewrites this from that file).
HAIKU_REVISION = r5-2026.1-dev ;

DefineBuildProfile r5-raw : image : "r5-os.image" ;
DefineBuildProfile r5-anyboot : anyboot-image : "r5-os-anyboot.iso" ;
DefineBuildProfile r5-vmware : vmware-image : "r5-os.vmdk" ;

switch $(HAIKU_BUILD_PROFILE) {
	case "r5-*" : {
		HAIKU_ROOT_USER_NAME = user ;
		HAIKU_ROOT_USER_REAL_NAME = "R5OS" ;
		HAIKU_IMAGE_HOST_NAME = r5os ;
		HAIKU_IMAGE_LABEL = "R5OS" ;
		HAIKU_IMAGE_SIZE = 2048 ;

		AddGroupToHaikuImage party : 101 : user sshd ;

		AddOptionalHaikuImagePackages Welcome WebPositive Development Git ;
		AddHaikuImageSystemPackages
			openssh
			openssl3
			pe
			vision
			wpa_supplicant
			libglvnd
			mesa
			mesa_devel
			mesa_lavapipe
			llvm21_runtime
			vulkan_loader
			;

		# The downloaded HaikuPorts catalog still lists Mesa 22. The image
		# solver uses these files instead, written by scripts/pin-mesa-packages.sh.
		local r5Download = [ FDirName $(HAIKU_OUTPUT_DIR) download ] ;
		HAIKU_REPOSITORY_CACHE_FILE on <repository>HaikuPorts
			= [ FDirName $(r5Download) r5-haikuports.repo ] ;
		local r5OpenGL = r5opengl ;
		HAIKU_REPOSITORIES += $(r5OpenGL:G=repository) ;
		HAIKU_REPOSITORY_CACHE_FILE on $(r5OpenGL:G=repository)
			= [ FDirName $(r5Download) r5-opengl.repo ] ;
	}
}
