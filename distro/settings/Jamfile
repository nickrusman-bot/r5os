SubDir HAIKU_TOP src preferences settings ;

UsePrivateHeaders interface shared app net ;

# Connections and Discovery use the address field, the link speed and the
# service add-on classes of the Network program, unchanged
# (src/preferences/network, src/bin/network/ifconfig).
UsePublicHeaders [ FDirName add-ons network_settings ] ;
SubDirHdrs $(HAIKU_TOP) src preferences network ;
SubDirHdrs $(HAIKU_TOP) src bin network ifconfig ;
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src preferences network ] ;

