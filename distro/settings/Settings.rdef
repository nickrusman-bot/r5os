resource app_signature "application/x-vnd.R5OS-Settings";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "Settings",
	long_info = "R5OS settings host. Existing preference programs stay separate."
};

// Unmodified Haiku MIT icon (data/artwork/icons/Overlay_prefs).
resource(1, "prefs-overlay") #'VICN' import "overlay-prefs.hvif";

// The application icon is the R5 wave pebble from
// distro/rest/src/apps/aboutsystem/AboutSystem.rdef with the last
// two shapes of R_PrefsDirIcon (Haiku src/kits/tracker/TrackerIcons.rdef,
// the same wrench as overlay-prefs.hvif). Built by
// scripts/join-settings-icon.py. Do not edit the bytes by hand.
